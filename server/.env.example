# Server configuration
PORT=5000

# CORS Allowed Origin (set to your hosted frontend URL in production, e.g., https://noraizamaan.com)
# For local development, it defaults to allowing localhost:5173
FRONTEND_URL=http://localhost:5173

# Email service configuration (SMTP)
# Note: For Gmail, use your Gmail email address and generate a 16-character App Password.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# The address where you want to receive the contact form emails
RECEIVER_EMAIL=your_gmail_address@gmail.com
